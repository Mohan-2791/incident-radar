{
  "name": "incident-radar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run codegen",
    "dev": "vite",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run codegen && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "graphql": "^16.9.0",
    "graphql-ws": "^5.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "urql": "^4.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/client-preset": "^4.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
